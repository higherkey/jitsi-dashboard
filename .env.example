# Jitsi Directory Path (where docker-compose.yml and .env reside)
JITSI_DIR=Z:\jitsi-meet

# Dashboard Server Settings
PORT=3001
HOST=0.0.0.0
POLL_INTERVAL=5000

# Endpoint URLs
HTTPS_URL=https://localhost:8443
GRAFANA_URL=http://localhost:3000

# Auth & Session Security
ADMIN_PASSWORD=admin
SESSION_SECRET=jitsi_dashboard_default_secret_key_123

# Optional: Neon Postgres drop-in (if left empty or commented out, uses native node:sqlite)
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
